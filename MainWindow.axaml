<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrtDrive.MainWindow"
        Title="CrtDrive"
        Width="420" Height="350">
    
    <StackPanel Margin="10" Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">

            <StackPanel>
                <TextBlock Text="Brightness"/>
                <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" Value="0"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Contrast"/>
                <Slider x:Name="ContrastSlider" Minimum="0.5" Maximum="3" Value="1"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Threshold"/>
                <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="255" Value="170"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel>
                <TextBlock Text="Edge Strength"/>
                <Slider x:Name="EdgeStrengthSlider" Minimum="0" Maximum="5" Value="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Gamma"/>
                <Slider x:Name="GammaSlider" Minimum="0.1" Maximum="5" Value="1"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Erode"/>
                <Slider x:Name="ErodeSlider" Minimum="0" Maximum="5" Value="0"/>
            </StackPanel>
           
            <StackPanel>
                <TextBlock Text="Dilate"/>
                <Slider x:Name="DilateSlider" Minimum="0" Maximum="5" Value="0"/>
            </StackPanel>
             <StackPanel>
                <TextBlock Text="AdaptiveExposure"/>
                <Slider x:Name="AdaptiveExposureSlider" Minimum="0" Maximum="5"  Value="0.5"/>
            </StackPanel>

            
            <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox x:Name="VectorModeCheckBox"
                        Content="Vector mode"
                        IsChecked="False"
                        VerticalAlignment="Center"/>

                <StackPanel>
                    <TextBlock Text="Max segments"/>
                    <Slider x:Name="MaxSegmentsSlider"
                            Minimum="10" Maximum="300"
                            Value="100" Width="120"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Vector threshold"/>
                    <Slider x:Name="VectorThresholdSlider"
                            Minimum="0" Maximum="255"
                            Value="170" Width="120"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Simplify"/>
                    <Slider x:Name="VectorToleranceSlider"
                            Minimum="0.5" Maximum="5"
                            Value="1.5" Width="120"/>
                </StackPanel>
            </StackPanel>
            
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Image x:Name="OriginalImage" Width="240" Height="150"/>
            <Image x:Name="ProcessedImage" Width="150" Height="150">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="-1"/>
                </Image.RenderTransform>
            </Image>
        </StackPanel>
    </StackPanel>
</Window>